<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

using System;
using System.Threading;
using System.Collections.Generic;
using System.Linq;
using LuminThread.Utility;

namespace LuminThread.TaskSource.Promise;

<#
// 生成泛型元组版本的 WhenAnyPromise (2-4)。更高 arity 的异构 overload 已按架构文档 §8/§9 删除。
for (int i = 2; i <= 4; i++)
{
    var typeParams = string.Join(", ", Enumerable.Range(1, i).Select(n => $"T{n}"));
    var taskParams = string.Join(", ", Enumerable.Range(1, i).Select(n => $"LuminTask<T{n}> task{n}"));
    var resultTuple = string.Join(", ", Enumerable.Range(1, i).Select(n => $"self.t{n}"));
#>
internal sealed class WhenAnyPromise<<#= typeParams #>> : CombinerNode
{
<# for (int j = 1; j <= i; j++) { #>
    T<#= j #> t<#= j #> = default!;
<# } #>
<# for (int j = 1; j <= i; j++) { #>
    private LuminTask<T<#= j #>> _task<#= j #>;
<# } #>

    public WhenAnyPromise(<#= taskParams #>)
    {
<# for (int j = 1; j <= i; j++) { #>
        {
            _task<#= j #> = task<#= j #>;
            if (task<#= j #>.IsCompleted)
            {
                TryInvokeContinuationT<#= j #>(this);
            }
            else
            {
                task<#= j #>.SourceOnCompleted(ChildContinuation<#= j - 1 #>, this);
            }
        }
<# } #>
    }

    internal override void OnChildCompleted(int index)
    {
        switch (index)
        {
<# for (int j = 1; j <= i; j++) { #>
            <#= (j == i) ? "default" : ("case " + (j - 1)) #>: TryInvokeContinuationT<#= j #>(this); break;
<# } #>
        }
    }

<# for (int j = 1; j <= i; j++) { #>
    static void TryInvokeContinuationT<#= j #>(WhenAnyPromise<<#= typeParams #>> self)
    {
        if (!self.IncrementCompleted(1))
        {
            LuminTaskHandle loser = self._task<#= j #>._handle;
            if (!loser.IsNull())
                LuminTaskCoreSource.Forget(loser);
            return;
        }

        try
        {
            self.t<#= j #> = self._task<#= j #>.GetResult();
        }
        catch (Exception ex)
        {
            self.Fault(ex);
            return;
        }

        var result = (<#= j - 1 #>, <#= resultTuple #>);
        self.Complete(in result);
    }

<# } #>
}

<# } #>
internal sealed class WhenAnyPromise<T> : CombinerNode
{
    public WhenAnyPromise(LuminTask<T>[]? tasks)
    {
        if (tasks == null || tasks.Length == 0)
        {
            Fault(new InvalidOperationException("No tasks provided"));
            return;
        }

        for (int i = 0; i < tasks.Length; i++)
        {
            var index = i;
            var awaiter = tasks[i].GetAwaiter();

            if (awaiter.IsCompleted)
            {
                TryInvokeContinuation(this, awaiter, index);
            }
            else
            {
                // 挂起中的孩子必定拥有槽位，句柄即可唯一确定它：状态不带 T，与其它结果类型、
                // 与 WhenAll 数组版共用同一个池和一个非泛型委托。
                awaiter.SourceOnCompleted(ChildStateContinuation,
                    StateTuple.Create(new ChildState(this, awaiter._handle, index)));
            }
        }
    }

    internal override void OnSuspendedChildCompleted(LuminTaskHandle handle, int index)
        => TryInvokeContinuation(this, LuminTaskSource.ToTask<T>(handle), index);

    static void TryInvokeContinuation(WhenAnyPromise<T> self, in LuminTask<T> awaiter, int index)
    {
        if (!self.IncrementCompleted(1))
        {
            LuminTaskHandle loser = awaiter._handle;
            if (!loser.IsNull())
                LuminTaskCoreSource.Forget(loser);
            return;
        }

        // Exactly one child wins, and only its value is ever read: it lives in a local instead of
        // an array sized to the whole input, which used to be allocated per call for one element.
        T value;
        try
        {
            value = awaiter.GetResult();
        }
        catch (Exception ex)
        {
            self.Fault(ex);
            return;
        }

        var result = (index, value);
        self.Complete(in result);
    }
}

<#
// 生成非泛型 WhenAnyPromise 的 2-4 个参数版本
for (int i = 2; i <= 4; i++)
{
    var taskParams = string.Join(", ", Enumerable.Range(1, i).Select(n => $"LuminTask task{n}"));
#>
internal sealed class WhenAnyPromise<#= i #> : CombinerNode
{
<# for (int j = 1; j <= i; j++) { #>
    private LuminTask _task<#= j #>;
<# } #>

    public WhenAnyPromise<#= i #>(<#= taskParams #>)
    {
<# for (int j = 1; j <= i; j++) { #>
        {
            _task<#= j #> = task<#= j #>;
            if (task<#= j #>.IsCompleted)
            {
                TryInvokeContinuationT<#= j #>(this);
            }
            else
            {
                task<#= j #>.SourceOnCompleted(ChildContinuation<#= j - 1 #>, this);
            }
        }
<# } #>
    }

    internal override void OnChildCompleted(int index)
    {
        switch (index)
        {
<# for (int j = 1; j <= i; j++) { #>
            <#= (j == i) ? "default" : ("case " + (j - 1)) #>: TryInvokeContinuationT<#= j #>(this); break;
<# } #>
        }
    }

<# for (int j = 1; j <= i; j++) { #>
    static void TryInvokeContinuationT<#= j #>(WhenAnyPromise<#= i #> self)
    {
        if (!self.IncrementCompleted(1))
        {
            LuminTaskHandle loser = self._task<#= j #>._handle;
            if (!loser.IsNull())
                LuminTaskCoreSource.Forget(loser);
            return;
        }

        try
        {
            self._task<#= j #>.GetResult();
        }
        catch (Exception ex)
        {
            self.Fault(ex);
            return;
        }

        self.Complete(<#= j - 1 #>);
    }
<# } #>
}

<# } #>
internal sealed class WhenAnyPromise : CombinerNode
{
    public WhenAnyPromise(LuminTask[]? tasks)
    {
        if (tasks == null || tasks.Length == 0)
        {
            Fault(new InvalidOperationException("No tasks provided"));
            return;
        }

        for (int i = 0; i < tasks.Length; i++)
        {
            var index = i;
            var awaiter = tasks[i].GetAwaiter();

            if (awaiter.IsCompleted)
            {
                TryInvokeContinuation(this, awaiter, index);
            }
            else
            {
                awaiter.SourceOnCompleted(ChildStateContinuation,
                    StateTuple.Create(new ChildState(this, awaiter._handle, index)));
            }
        }
    }

    internal override void OnSuspendedChildCompleted(LuminTaskHandle handle, int index)
        => TryInvokeContinuation(this, LuminTaskSource.ToTask(handle), index);

    static void TryInvokeContinuation(WhenAnyPromise self, in LuminTask awaiter, int index)
    {
        if (!self.IncrementCompleted(1))
        {
            LuminTaskHandle loser = awaiter._handle;
            if (!loser.IsNull())
                LuminTaskCoreSource.Forget(loser);
            return;
        }

        try
        {
            awaiter.GetResult();
        }
        catch (Exception ex)
        {
            self.Fault(ex);
            return;
        }

        self.Complete(index);
    }
}