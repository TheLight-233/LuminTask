<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

using System;
using System.Threading;
using System.Collections.Generic;
using System.Linq;
using LuminThread.Utility;

namespace LuminThread.TaskSource.Promise;

<#
// 生成泛型元组版本的 WhenAllPromise (2-4)。更高 arity 的异构 overload 已按架构文档 §8/§9 删除。
for (int i = 2; i <= 4; i++)
{
    var typeParams = string.Join(", ", Enumerable.Range(1, i).Select(n => $"T{n}"));
    var taskParams = string.Join(", ", Enumerable.Range(1, i).Select(n => $"LuminTask<T{n}> task{n}"));
    var resultTuple = string.Join(", ", Enumerable.Range(1, i).Select(n => $"self.t{n}"));
#>
internal sealed class WhenAllPromise<<#= typeParams #>> : CombinerNode
{
<# for (int j = 1; j <= i; j++) { #>
    T<#= j #> t<#= j #> = default!;
<# } #>
<# for (int j = 1; j <= i; j++) { #>
    private LuminTask<T<#= j #>> _task<#= j #>;
<# } #>

    public WhenAllPromise(<#= taskParams #>)
    {
<# for (int j = 1; j <= i; j++) { #>
        {
            _task<#= j #> = task<#= j #>;
            if (task<#= j #>.IsCompleted)
            {
                TryInvokeContinuationT<#= j #>(this);
            }
            else
            {
                task<#= j #>.SourceOnCompleted(ChildContinuation<#= j - 1 #>, this);
            }
        }
<# } #>
    }

    internal override void OnChildCompleted(int index)
    {
        switch (index)
        {
<# for (int j = 1; j <= i; j++) { #>
            <#= (j == i) ? "default" : ("case " + (j - 1)) #>: TryInvokeContinuationT<#= j #>(this); break;
<# } #>
        }
    }

<# for (int j = 1; j <= i; j++) { #>
    static void TryInvokeContinuationT<#= j #>(WhenAllPromise<<#= typeParams #>> self)
    {
        try
        {
            self.t<#= j #> = self._task<#= j #>.GetResult();
        }
        catch (Exception ex)
        {
            self.Fault(ex);
            return;
        }

        if (self.IncrementCompleted(<#= i #>))
        {
            var result = (<#= resultTuple #>);
            self.Complete(in result);
        }
    }

<# } #>
}

<# } #>
<#
// 生成非泛型 WhenAllPromise 的 1-4 个参数版本
for (int i = 1; i <= 4; i++)
{
    var taskParams = string.Join(", ", Enumerable.Range(1, i).Select(n => $"LuminTask task{n}"));
#>
internal sealed class WhenAllPromise<#= i #> : CombinerNode
{
    private int _totalCount = <#= i #>;
<# for (int j = 1; j <= i; j++) { #>
    private LuminTask _task<#= j #>;
<# } #>

    public WhenAllPromise<#= i #>(<#= taskParams #>)
    {
<# for (int j = 1; j <= i; j++) { #>
        {
            _task<#= j #> = task<#= j #>;
            if (task<#= j #>.IsCompleted)
            {
                TryInvokeContinuationT<#= j #>(this);
            }
            else
            {
                task<#= j #>.SourceOnCompleted(ChildContinuation<#= j - 1 #>, this);
            }
        }
<# } #>
    }

    internal override void OnChildCompleted(int index)
    {
        switch (index)
        {
<# for (int j = 1; j <= i; j++) { #>
            <#= (j == i) ? "default" : ("case " + (j - 1)) #>: TryInvokeContinuationT<#= j #>(this); break;
<# } #>
        }
    }

<# for (int j = 1; j <= i; j++) { #>
    static void TryInvokeContinuationT<#= j #>(WhenAllPromise<#= i #> self)
    {
        try
        {
            self._task<#= j #>.GetResult();
        }
        catch (Exception ex)
        {
            self.Fault(ex);
            return;
        }

        if (self.IncrementCompleted(self._totalCount))
        {
            self.Complete();
        }
    }
<# } #>
}

<# } #>
internal sealed class WhenAllPromise<T> : CombinerNode
{
    private T[] _results;
    private int _totalCount;

    public WhenAllPromise(LuminTask<T>[]? tasks)
    {
        if (tasks == null || tasks.Length == 0)
        {
            _results = Array.Empty<T>();
            Complete(in _results);
            return;
        }

        _totalCount = tasks.Length;
        _results = new T[_totalCount];

        for (int i = 0; i < tasks.Length; i++)
        {
            var index = i;
            var awaiter = tasks[i].GetAwaiter();

            if (awaiter.IsCompleted)
            {
                TryInvokeContinuation(this, awaiter, index);
            }
            else
            {
                awaiter.SourceOnCompleted(static state =>
                {
                    var tuple = (StateTuple<(WhenAllPromise<T>, LuminTask<T>, int)>)state;
                    var owner = tuple.Item.Item1;
                    var awaiter = tuple.Item.Item2;
                    var index = tuple.Item.Item3;
                    tuple.Dispose();
                    TryInvokeContinuation(owner, awaiter, index);
                }, StateTuple.Create((this, awaiter, index)));
            }
        }
    }

    static void TryInvokeContinuation(WhenAllPromise<T> self, in LuminTask<T> awaiter, int index)
    {
        try
        {
            self._results[index] = awaiter.GetResult();
        }
        catch (Exception ex)
        {
            self.Fault(ex);
            return;
        }

        if (self.IncrementCompleted(self._totalCount))
        {
            self.Complete(in self._results);
        }
    }
}

internal sealed class WhenAllPromise : CombinerNode
{
    private int _totalCount;

    public WhenAllPromise(LuminTask[]? tasks)
    {
        if (tasks == null || tasks.Length == 0)
        {
            Complete();
            return;
        }

        _totalCount = tasks.Length;

        for (int i = 0; i < tasks.Length; i++)
        {
            var awaiter = tasks[i].GetAwaiter();

            if (awaiter.IsCompleted)
            {
                TryInvokeContinuation(this, awaiter);
            }
            else
            {
                awaiter.SourceOnCompleted(static state =>
                {
                    var tuple = (StateTuple<(WhenAllPromise, LuminTask)>)state;
                    var owner = tuple.Item.Item1;
                    var awaiter = tuple.Item.Item2;
                    tuple.Dispose();
                    TryInvokeContinuation(owner, awaiter);
                }, StateTuple.Create(this, awaiter));
            }
        }
    }

    static void TryInvokeContinuation(WhenAllPromise self, in LuminTask awaiter)
    {
        try
        {
            awaiter.GetResult();
        }
        catch (Exception ex)
        {
            self.Fault(ex);
            return;
        }

        if (self.IncrementCompleted(self._totalCount))
        {
            self.Complete();
        }
    }
}