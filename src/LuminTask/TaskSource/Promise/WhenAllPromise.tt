                LuminTaskSourceCore<<#= tupleType #>>.TrySetException(self.core, ex);
            return;
        }
                
        if (Interlocked.Increment(ref self.completedCount) == <#= i #> &&
            Interlocked.CompareExchange(ref self.completionState, 1, 0) == 0)
