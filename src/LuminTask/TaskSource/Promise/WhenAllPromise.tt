            LuminTaskSourceCore<<#= tupleType #>>.TrySetResult(self.core, (self.t1<# for (int k = 2; k <= i; k++) { #>, self.t<#= k #><# } #>));
        }
    }

<# } #>
}

<# } #>

<#
// 生成非泛型 WhenAllPromise 的 1-15 个参数版本
for (int i = 1; i <= 15; i++)
{
    var taskParams = string.Join(", ", Enumerable.Range(1, i).Select(n => $"LuminTask task{n}"));
    var taskParamsWithType = string.Join(", ", Enumerable.Range(1, i).Select(n => $"LuminTask task{n}"));
#>
public sealed unsafe class WhenAllPromise<#= i #>
{
    private int _completedCount;
    private int _totalCount = <#= i #>;
    private int _completionState;
    internal LuminTaskSourceCore<bool>* _core;

    public WhenAllPromise<#= i #>(<#= taskParams #>)
    {
        _core = LuminTaskSourceCore<bool>.Create();
        _completedCount = 0;

<# for (int j = 1; j <= i; j++) { #>
        {
            var awaiter = task<#= j #>.GetAwaiter();
            if (awaiter.IsCompleted)
            {
                TryInvokeContinuationT<#= j #>(this, awaiter);
            }
            else
            {
                awaiter.SourceOnCompleted(static state =>
                {
                    var t = (StateTuple<(WhenAllPromise<#= i #>, LuminTask)>)state;
                    var owner = t.Item.Item1;
                    var awaiter = t.Item.Item2;
                    t.Dispose();
                    TryInvokeContinuationT<#= j #>(owner, awaiter);
                }, StateTuple.Create(this, awaiter));
            }
        }
<# } #>
    }

<# for (int j = 1; j <= i; j++) { #>
    static void TryInvokeContinuationT<#= j #>(WhenAllPromise<#= i #> self, in LuminTask awaiter)
    {
        try
        {
            awaiter.GetResult();
        }
        catch (Exception ex)
        {
            if (Interlocked.CompareExchange(ref self._completionState, 1, 0) == 0)
                LuminTaskSourceCore<bool>.TrySetException(self._core, ex);
            return;
        }
                
        if (Interlocked.Increment(ref self._completedCount) == self._totalCount &&
            Interlocked.CompareExchange(ref self._completionState, 1, 0) == 0)
