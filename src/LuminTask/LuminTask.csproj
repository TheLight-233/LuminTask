<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <LangVersion>13</LangVersion>
        <TargetFrameworks>netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
        <NoWarn>$(NoWarn);CS1591;CA2255;LUM1001;LUM1002;LUM1003;LUM1004;LUM1005;LUM1006;LUM1007;LUM1008;LUM9999</NoWarn>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <PackageId>LuminTask</PackageId>
        <Version>2.0.0</Version>
        <Authors>TheLight233</Authors>
        <Description>High-performance custom async/await task-like types for .NET.</Description>
        <PackageTags>async;task;awaitable;zero-allocation</PackageTags>
        <PackageProjectUrl>https://github.com/TheLight-233/LuminTask</PackageProjectUrl>
        <RepositoryUrl>https://github.com/TheLight-233/LuminTask.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <!-- AsyncEx 拆分为独立程序集后，需要访问句柄驱动的内部桥接
             （RentSlot / LuminTaskSource / LuminTaskResultBridge / 句柄字段）。
             用 InternalsVisibleTo 定向开放，避免把这些成员提升为公开 API。 -->
        <InternalsVisibleTo Include="LuminTask.AsyncEx" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\analyzer\LuminTask.Analyzer\LuminTask.Analyzer.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <None Include="..\..\analyzer\LuminTask.Analyzer\bin\$(Configuration)\netstandard2.0\LuminTask.Analyzer.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\LuminTask.AsyncEx\bin\$(Configuration)\netstandard2.1\LuminTask.AsyncEx.dll"
              Pack="true" PackagePath="lib\netstandard2.1" Visible="false" />
        <None Include="..\LuminTask.AsyncEx\bin\$(Configuration)\net8.0\LuminTask.AsyncEx.dll"
              Pack="true" PackagePath="lib\net8.0" Visible="false" />
        <None Include="..\LuminTask.AsyncEx\bin\$(Configuration)\net9.0\LuminTask.AsyncEx.dll"
              Pack="true" PackagePath="lib\net9.0" Visible="false" />
        <None Include="..\LuminTask.AsyncEx\bin\$(Configuration)\net10.0\LuminTask.AsyncEx.dll"
              Pack="true" PackagePath="lib\net10.0" Visible="false" />
    </ItemGroup>

</Project>
