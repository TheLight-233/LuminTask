<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <LangVersion>13</LangVersion>
        <TargetFrameworks>netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
        <NoWarn>$(NoWarn);CS1591;CA2255;LUM1001;LUM1002;LUM1003;LUM1004;LUM1005;LUM1006;LUM1007;LUM1008;LUM9999</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageId>LuminTask</PackageId>
        <Version>1.0.7</Version>
        <Authors>TheLight233</Authors>
        <Description>High-performance custom async/await task-like types for .NET.</Description>
        <PackageTags>async;task;awaitable;zero-allocation</PackageTags>
        <PackageProjectUrl>https://github.com/TheLight-233/LuminTask</PackageProjectUrl>
        <RepositoryUrl>https://github.com/TheLight-233/LuminTask.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 契约分析器：
             1) ProjectReference(OutputItemType=Analyzer) 让库自身构建时被检查（dogfooding），
                只作用于本项目的编译，不会传递给 ProjectReference 引用方；
             2) None Include 把分析器 dll 直接打进 LuminTask 的 NuGet 包（analyzers/dotnet/cs），
                消费者只需安装 LuminTask 一个包，分析器即自动生效（报告 LUM1001~LUM1006）。
             库内部实现（PlayerLoop 轮询延迟消费、三元表达式转移等）不受面向使用方的
             契约约束，因此在本项目 NoWarn 中屏蔽 LUM 诊断。 -->
        <ProjectReference Include="..\..\analyzer\LuminTask.Analyzer\LuminTask.Analyzer.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <None Include="..\..\analyzer\LuminTask.Analyzer\bin\$(Configuration)\netstandard2.0\LuminTask.Analyzer.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <None Update="TaskSource\Promise\WhenAllPromise.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>WhenAllPromise.cs</LastGenOutput>
      </None>
      <None Update="TaskSource\Promise\WhenAnyPromise.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>WhenAnyPromise.cs</LastGenOutput>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="TaskSource\Promise\WhenAllPromise.cs">
        <DependentUpon>WhenAllPromise.tt</DependentUpon>
      </Compile>
      <Compile Update="TaskSource\Promise\WhenAnyPromise.cs">
        <DependentUpon>WhenAnyPromise.tt</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>





