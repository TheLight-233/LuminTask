<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <LangVersion>13</LangVersion>
        <TargetFrameworks>netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
        <NoWarn>$(NoWarn);CS1591;CA2255;LUM1001;LUM1002;LUM1003;LUM1004;LUM1005;LUM1006;LUM1007;LUM1008;LUM9999</NoWarn>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <PackageId>LuminTask</PackageId>
        <Version>$(LuminTaskVersion)</Version>
        <Authors>TheLight233</Authors>
        <Description>High-performance custom async/await task-like types for .NET.</Description>
        <PackageTags>async;task;awaitable;zero-allocation</PackageTags>
        <PackageProjectUrl>https://github.com/TheLight-233/LuminTask</PackageProjectUrl>
        <RepositoryUrl>https://github.com/TheLight-233/LuminTask.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeAsyncExInPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="$(UnsafeVersion)" />
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <!-- AsyncEx 拆分为独立程序集后，需要访问句柄驱动的内部桥接
             （RentSlot / LuminTaskSource / LuminTaskResultBridge / 句柄字段）。
             用 InternalsVisibleTo 定向开放，避免把这些成员提升为公开 API。 -->
        <InternalsVisibleTo Include="LuminTask.AsyncEx" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LuminTask.Analyzer\LuminTask.Analyzer.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <None Include="..\LuminTask.Analyzer\bin\$(Configuration)\netstandard2.0\LuminTask.Analyzer.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <Target Name="IncludeAsyncExInPackage">
        <PropertyGroup>
            <AsyncExOutput>$(MSBuildThisFileDirectory)../LuminTask.AsyncEx/bin/$(Configuration)/$(TargetFramework)</AsyncExOutput>
        </PropertyGroup>
        <Error Condition="!Exists('$(AsyncExOutput)/LuminTask.AsyncEx.dll') Or !Exists('$(AsyncExOutput)/LuminTask.AsyncEx.pdb')"
               Text="Build LuminTask.AsyncEx for $(TargetFramework) before packing LuminTask, or use eng/release.ps1." />
        <ItemGroup>
            <BuildOutputInPackage Include="$(AsyncExOutput)/LuminTask.AsyncEx.dll;$(AsyncExOutput)/LuminTask.AsyncEx.pdb" />
        </ItemGroup>
    </Target>

</Project>
