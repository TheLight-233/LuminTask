<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- 纯分析器包：developmentDependency 使 NuGet 还原时始终携带 analyzers 资产，
             不会向消费方传递任何运行时依赖。
             RS2008：发布跟踪仅适用于 DiagnosticAnalyzer，源生成器无 SupportedDiagnostics。 -->
        <DevelopmentDependency>true</DevelopmentDependency>
        <NoWarn>$(NoWarn);RS1035;RS2008</NoWarn>
        <Version>1.0.0</Version>
        <Description>Roslyn source generator that enforces LuminTask single-consumption contracts at compile time.</Description>
        <PackageId>LuminTask.Analyzer</PackageId>
        <PackageTags>analyzer;generator;LuminTask;contract</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- 4.3.0 是 Unity 支持的 Roslyn 最高版本，analyzer 二进制需与其兼容 -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- roslyn 版本子目录形式，确保分析器资产在还原时被 NuGet 选中 -->
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.3/cs" Visible="false" />
    </ItemGroup>

</Project>
